# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
JWT_SECRET=
TWELVE_DATA_API_KEY=
CORS_ORIGIN=http://localhost:3000
PORT=

# Proxy hops Express trusts, so the /auth rate limit counts per visitor.
# 0 for local development. In production use the measured value (02-backend.md, section 4).
TRUST_PROXY_HOPS=0

# Demo account. Public by design. Read only by `npm run seed:demo`.
DEMO_EMAIL=
DEMO_PASSWORD=
